# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# package manager
/package-lock.json

# private artwork (never commit raw licensed master assets to public GitHub)
/assets/templates/*/originals/
/private-assets/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Impeccable design-review runtime/cache
.impeccable/

# private/runtime media (customer uploads must never enter Git/web root)
/.undara-data/
/public/uploads/

# Disposable public-gallery browser QA evidence
/artifacts/template-browser/
